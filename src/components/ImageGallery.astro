---
import type { ImageMetadata } from 'astro';
import config from 'virtual:astro-gallery/config';
import { resolveAlt } from '../internal/alt.js';
import { fixedImage, responsiveImage } from '../internal/images.js';
import { basename, resolveFolder, selectFolderEntries } from '../internal/paths.js';
import { imageGalleryJsonLd, type LdImage } from '../internal/structured-data.js';
import '../styles/gallery.css';

type ImageInput = {
  /** An `import`ed image, a `/public` path or a remote URL. */
  src: string | ImageMetadata;
  alt?: string;
  caption?: string;
};

interface Props {
  /** Explicit images. Use this or `folderPath`, not both. */
  images?: ImageInput[];
  /** Folder relative to `src/<imagesDir>/` — every image inside is used, sorted by name. */
  folderPath?: string;
  /** Override the integration's `imagesDir` for this instance. */
  baseDir?: string;
  /** Columns on the widest breakpoint. */
  columns?: 1 | 2 | 3 | 4 | 5;
  /**
   * `"grid"` crops every cell to the same rectangle. `"masonry"` keeps each
   * photo's own aspect ratio and packs the columns tight — the caption then
   * rides on the image as a hover scrim instead of sitting underneath it.
   */
  variant?: 'grid' | 'masonry';
  /** CSS gap between items, e.g. `"1.5rem"`. */
  gap?: string;
  /** `loading` attribute for the thumbnails (first image is always eager). */
  loading?: 'lazy' | 'eager';
  /** Set `false` to link straight to the full image instead of opening the lightbox. */
  lightbox?: boolean;
  /** Per-file alt overrides (folder mode), keyed by file name. */
  alt?: Record<string, string>;
  /** Per-file caption overrides (folder mode), keyed by file name. */
  captions?: Record<string, string>;
  /** Album / gallery name — used for the accessible label, fallback alt and JSON-LD. */
  album?: string;
  /** `<img sizes>` attribute. Defaults from the column count. */
  sizes?: string;
  /** Emit `ImageGallery` JSON-LD. Defaults to the integration setting. */
  structuredData?: boolean;
}

const {
  images,
  folderPath,
  baseDir = config.imagesDir,
  columns = 3,
  variant = 'grid',
  gap,
  loading = 'lazy',
  lightbox = true,
  alt: altMap = {},
  captions = {},
  album,
  sizes,
  structuredData = config.structuredData,
} = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/**/*.{jpg,jpeg,png,webp,avif,gif,tiff,JPG,JPEG,PNG,WEBP,AVIF,GIF,TIFF}',
  { eager: true },
);

interface Entry {
  src: string;
  srcset: string;
  fullSrc: string;
  alt: string;
  caption: string;
  width?: number;
  height?: number;
}

/**
 * Row-span for the masonry variant. `grid-auto-rows` ticks in `ROW_UNIT`
 * slices; a taller (or narrower) photo just claims more of them. `REF_WIDTH`
 * is a nominal column width — its exact value doesn't matter, only that every
 * span is computed against the same one, since it cancels out visually.
 */
const ROW_UNIT = 8;
const REF_WIDTH = 400;
function masonrySpan(width?: number, height?: number): number {
  if (!width || !height) return 24;
  return Math.max(6, Math.ceil((REF_WIDTH / (width / height) + 12) / ROW_UNIT));
}

const widths = config.responsiveWidths;
const format = config.imageFormat;
const defaultSizes = `(min-width: 640px) ${Math.round(100 / columns)}vw, 100vw`;
const imgSizes = sizes ?? defaultSizes;

let entries: Entry[] = [];

if (folderPath) {
  const target = resolveFolder(baseDir, folderPath);
  const matched = selectFolderEntries(allImages, target);
  entries = await Promise.all(
    matched.map(async ([key, mod], i): Promise<Entry> => {
      const file = basename(key);
      const [responsive, full] = await Promise.all([
        responsiveImage(mod.default, { widths, format }),
        fixedImage(mod.default, { width: config.fullWidth, format }),
      ]);
      return {
        src: responsive.src,
        srcset: responsive.srcset,
        fullSrc: full.src,
        alt: resolveAlt({ file, explicit: altMap[file], album, index: i + 1 }),
        caption: captions[file] ?? '',
        width: responsive.width,
        height: responsive.height,
      };
    }),
  );
} else if (images?.length) {
  entries = await Promise.all(
    images.map(async ({ src, alt = '', caption = '' }, i): Promise<Entry> => {
      if (typeof src === 'string') {
        return {
          src,
          srcset: '',
          fullSrc: src,
          alt: resolveAlt({ file: src, explicit: alt, album, index: i + 1 }),
          caption,
        };
      }
      const [responsive, full] = await Promise.all([
        responsiveImage(src, { widths, format }),
        fixedImage(src, { width: config.fullWidth, format }),
      ]);
      return {
        src: responsive.src,
        srcset: responsive.srcset,
        fullSrc: full.src,
        alt: alt || resolveAlt({ file: `photo-${i + 1}`, album, index: i + 1 }),
        caption,
        width: responsive.width,
        height: responsive.height,
      };
    }),
  );
}

const label = album ? `${album} gallery` : 'Image gallery';

const jsonLd =
  structuredData && entries.length > 0
    ? imageGalleryJsonLd(
        entries.map((e): LdImage => ({
          contentUrl: e.fullSrc,
          thumbnailUrl: e.src,
          name: e.alt,
          caption: e.caption || undefined,
          width: e.width,
          height: e.height,
        })),
        { name: album ?? undefined, siteUrl: Astro.site },
      )
    : '';
---

{
  entries.length > 0 && (
    <>
      <ul
        class:list={['asg-gallery', `asg-gallery--cols-${columns}`, `asg-gallery--${variant}`]}
        role="list"
        aria-label={label}
        style={gap ? `--asg-gap:${gap}` : undefined}
        data-asg-lightbox={lightbox ? 'true' : 'false'}
        data-asg-reveal="true"
      >
        {entries.map((e, i) => (
          <li
            class="asg-gallery__cell"
            style={
              variant === 'masonry'
                ? `--asg-span:${masonrySpan(e.width, e.height)};--asg-reveal-i:${i}`
                : `--asg-reveal-i:${i}`
            }
          >
            <figure class="asg-gallery__figure">
              <a
                class="asg-gallery__item asg-lb-item"
                href={e.fullSrc}
                data-asg-full={e.fullSrc}
                data-asg-alt={e.alt}
                data-asg-caption={e.caption}
                aria-label={e.caption || e.alt}
              >
                <img
                  src={e.src}
                  srcset={e.srcset || undefined}
                  sizes={e.srcset ? imgSizes : undefined}
                  width={e.width}
                  height={e.height}
                  alt={e.alt}
                  loading={i === 0 ? 'eager' : loading}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  decoding="async"
                />
                <span class="asg-gallery__zoom" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="10.5" cy="10.5" r="6.5" />
                    <path d="M20 20l-4.7-4.7" stroke-linecap="round" />
                  </svg>
                </span>
                {variant === 'masonry' && e.caption && (
                  <span class="asg-gallery__scrim" aria-hidden="true" />
                )}
                {variant === 'masonry' && e.caption && (
                  <span class="asg-gallery__label">{e.caption}</span>
                )}
              </a>
              {variant === 'grid' && e.caption && (
                <figcaption class="asg-gallery__caption">{e.caption}</figcaption>
              )}
            </figure>
          </li>
        ))}
      </ul>
      {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    </>
  )
}

<script>
  import { initLightboxes } from '../internal/lightbox.js';

  /**
   * One orchestrated entrance per gallery: cells fade and rise into place as
   * they cross the viewport, staggered by their grid position. Fires once per
   * element, and never runs at all under `prefers-reduced-motion`.
   */
  function initReveal(): void {
    if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;
    const galleries = document.querySelectorAll<HTMLElement>('[data-asg-reveal="true"]');
    if (galleries.length === 0) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
    );

    galleries.forEach((gallery) => {
      gallery
        .querySelectorAll<HTMLElement>('.asg-gallery__cell:not([data-asg-observed])')
        .forEach((cell) => {
          cell.dataset.asgObserved = 'true';
          io.observe(cell);
        });
    });
  }

  initLightboxes();
  initReveal();
  document.addEventListener('astro:page-load', initReveal);
  document.addEventListener('astro:after-swap', initReveal);
</script>
