---
/**
 * Justified photo grid whose fullscreen view is a two-pane reader: the photo on
 * the left, an editorial caption panel on the right (title, caption and the
 * EXIF facts — date, camera, place, pixel size).
 *
 * Layout is the `<JustifiedGallery />` primitive (`.asg-jgallery`); this adds the
 * `.asg-egallery` variant and its own viewer (`.asg-eglb`).
 */
import { readFile } from 'node:fs/promises';
import type { ImageMetadata } from 'astro';
import config from 'virtual:astro-gallery/config';
import { resolveAlt } from '../internal/alt.js';
import { readPhotoMeta } from '../internal/exif.js';
import { fixedImage, responsiveImage } from '../internal/images.js';
import { createGeocoder } from '../internal/geocode.js';
import { basename, resolveFolder, selectFolderEntries, toAbsolute } from '../internal/paths.js';
import { imageGalleryJsonLd, type LdImage } from '../internal/structured-data.js';
import { pickText, type MaybeLocalized } from '../internal/i18n.js';
import '../styles/gallery.css';

type ImageInput = {
  /** An `import`ed image, a `/public` path or a remote URL. */
  src: string | ImageMetadata;
  alt?: string;
  title?: string;
  caption?: string;
};

/** Panel copy. Each entry is a string or a per-locale dictionary. */
export interface EditorialLabelOptions {
  date?: MaybeLocalized;
  location?: MaybeLocalized;
  camera?: MaybeLocalized;
  dimensions?: MaybeLocalized;
  close?: MaybeLocalized;
  previous?: MaybeLocalized;
  next?: MaybeLocalized;
  showDetails?: MaybeLocalized;
  hideDetails?: MaybeLocalized;
}

interface Props {
  /** Folder relative to `src/<imagesDir>/` — every image inside is used, sorted by name. */
  folderPath?: string;
  /** Explicit images. Use this or `folderPath`, not both. */
  images?: ImageInput[];
  /** Override the integration's `imagesDir` for this instance. */
  baseDir?: string;
  /** Target row height in px (rows are justified to fill the width). Default `280`. */
  rowHeight?: number;
  /** CSS gap between items, e.g. `"0.5rem"`. */
  gap?: string;
  /** First N images load eagerly with high priority (above-the-fold). Default `2`. */
  eager?: number;
  /** Per-file alt overrides (folder mode), keyed by file name. */
  alt?: Record<string, string>;
  /** Per-file caption overrides (folder mode), keyed by file name. */
  captions?: Record<string, string>;
  /** Per-file panel-title overrides (folder mode), keyed by file name. */
  titles?: Record<string, string>;
  /** Album / gallery name — the panel eyebrow, plus fallback alt and JSON-LD. */
  album?: string;
  /** Locale for the formatted capture date and the panel copy. */
  locale?: string;
  /** Reverse-geocode a place name for the panel. Defaults to the integration setting. */
  geocode?: boolean;
  /** Show the EXIF facts (date / camera / place / size) in the panel. Default `true`. */
  showMeta?: boolean;
  /** `<img sizes>` attribute. Default covers a 1–3 column responsive layout. */
  sizes?: string;
  /** Emit `ImageGallery` JSON-LD. Defaults to the integration setting. */
  structuredData?: boolean;
  /** Overrides for the viewer's UI strings. */
  labels?: EditorialLabelOptions;
}

const {
  folderPath,
  images,
  baseDir = config.imagesDir,
  rowHeight = 280,
  gap,
  eager = 2,
  alt: altMap = {},
  captions = {},
  titles = {},
  album,
  locale = config.locale,
  geocode: geocodeProp,
  showMeta = true,
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  structuredData = config.structuredData,
  labels = {},
} = Astro.props;

const geocodeEnabled = (geocodeProp ?? config.geocode.enabled) && showMeta;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/**/*.{jpg,jpeg,png,webp,avif,gif,tiff,JPG,JPEG,PNG,WEBP,AVIF,GIF,TIFF}',
  { eager: true },
);

interface Item {
  src: string;
  srcset: string;
  thumbSrc: string;
  fullSrc: string;
  width: number;
  height: number;
  aspectRatio: number;
  alt: string;
  title: string;
  caption: string;
  date: string;
  location: string;
  camera: string;
  dimensions: string;
}

const widths = config.responsiveWidths;
const format = config.imageFormat;
const geocoder = geocodeEnabled ? createGeocoder(config.geocode) : null;
let items: Item[] = [];

if (folderPath) {
  const target = resolveFolder(baseDir, folderPath);
  const matched = selectFolderEntries(allImages, target);
  const cwd = process.cwd();

  // Sequential: the geocoder rate-limits itself, and Promise.all would just
  // queue every lookup at once anyway.
  let i = 0;
  for (const [key, mod] of matched) {
    i += 1;
    const meta = mod.default;
    const file = basename(key);

    let exif = null as Awaited<ReturnType<typeof readPhotoMeta>> | null;
    try {
      exif = await readPhotoMeta(await readFile(toAbsolute(key, cwd)));
    } catch {
      /* unreadable — the item still renders, just without EXIF facts */
    }

    const [responsive, full, thumb] = await Promise.all([
      responsiveImage(meta, { widths, format }),
      fixedImage(meta, { width: config.fullWidth, format }),
      fixedImage(meta, { width: 240, format }),
    ]);

    const resolvedAlt = resolveAlt({
      file,
      explicit: altMap[file],
      description: exif?.description ?? null,
      album,
      index: i,
    });

    const location =
      geocoder && exif?.latitude != null && exif.longitude != null
        ? (await geocoder.reverseGeocode(exif.latitude, exif.longitude)).label
        : '';

    items.push({
      src: responsive.src,
      srcset: responsive.srcset,
      thumbSrc: thumb.src,
      fullSrc: full.src,
      width: responsive.width,
      height: responsive.height,
      aspectRatio: responsive.aspectRatio,
      alt: resolvedAlt,
      title: titles[file] ?? exif?.title ?? '',
      caption:
        captions[file] ??
        (exif?.description && exif.description !== resolvedAlt ? exif.description : ''),
      date:
        showMeta && exif?.date
          ? exif.date.toLocaleDateString(locale, {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
          : '',
      location,
      camera: showMeta ? (exif?.camera ?? '') : '',
      dimensions: showMeta ? `${meta.width} × ${meta.height}` : '',
    });
  }
} else if (images?.length) {
  items = await Promise.all(
    images.map(async ({ src, alt = '', title = '', caption = '' }, i): Promise<Item> => {
      if (typeof src === 'string') {
        return {
          src,
          srcset: '',
          thumbSrc: src,
          fullSrc: src,
          width: 0,
          height: 0,
          aspectRatio: 3 / 2,
          alt: resolveAlt({ file: src, explicit: alt, album, index: i + 1 }),
          title,
          caption,
          date: '',
          location: '',
          camera: '',
          dimensions: '',
        };
      }
      const [responsive, full, thumb] = await Promise.all([
        responsiveImage(src, { widths, format }),
        fixedImage(src, { width: config.fullWidth, format }),
        fixedImage(src, { width: 240, format }),
      ]);
      return {
        src: responsive.src,
        srcset: responsive.srcset,
        thumbSrc: thumb.src,
        fullSrc: full.src,
        width: responsive.width,
        height: responsive.height,
        aspectRatio: responsive.aspectRatio,
        alt: alt || resolveAlt({ file: `photo-${i + 1}`, album, index: i + 1 }),
        title,
        caption,
        date: '',
        location: '',
        camera: '',
        dimensions: showMeta ? `${src.width} × ${src.height}` : '',
      };
    }),
  );
}

geocoder?.flush();

const label = album ? `${album} gallery` : 'Image gallery';

const panelLabels = {
  album: album ?? '',
  date: pickText(labels.date, locale, 'Date'),
  location: pickText(labels.location, locale, 'Location'),
  camera: pickText(labels.camera, locale, 'Camera'),
  dimensions: pickText(labels.dimensions, locale, 'Dimensions'),
  close: pickText(labels.close, locale, 'Close'),
  previous: pickText(labels.previous, locale, 'Previous photo'),
  next: pickText(labels.next, locale, 'Next photo'),
  showDetails: pickText(labels.showDetails, locale, 'Show details'),
  hideDetails: pickText(labels.hideDetails, locale, 'Hide details'),
};

const jsonLd =
  structuredData && items.length > 0
    ? imageGalleryJsonLd(
        items.map((it): LdImage => ({
          contentUrl: it.fullSrc,
          thumbnailUrl: it.src,
          name: it.title || it.alt,
          caption: it.caption || undefined,
          width: it.width || undefined,
          height: it.height || undefined,
        })),
        { name: album ?? undefined, siteUrl: Astro.site },
      )
    : '';
---

{
  items.length > 0 && (
    <>
      <ul
        class="asg-jgallery asg-egallery"
        role="list"
        aria-label={label}
        data-asg-eglb
        data-asg-eglb-labels={JSON.stringify(panelLabels)}
        style={`--asg-row-h:${rowHeight}px;${gap ? `--asg-gap:${gap};` : ''}`}
      >
        {items.map((it, i) => (
          <li class="asg-jgallery__cell" style={`--asg-ar:${it.aspectRatio.toFixed(4)}`}>
            <figure class="asg-jgallery__figure">
              <a
                class="asg-jgallery__item asg-eg-item"
                href={it.fullSrc}
                data-asg-full={it.fullSrc}
                data-asg-thumb={it.thumbSrc}
                data-asg-alt={it.alt}
                data-asg-title={it.title}
                data-asg-caption={it.caption}
                data-asg-date={it.date}
                data-asg-location={it.location}
                data-asg-camera={it.camera}
                data-asg-dimensions={it.dimensions}
                aria-label={it.title || it.caption || it.alt}
              >
                <img
                  src={it.src}
                  srcset={it.srcset || undefined}
                  sizes={it.srcset ? sizes : undefined}
                  width={it.width || undefined}
                  height={it.height || undefined}
                  alt={it.alt}
                  loading={i < eager ? 'eager' : 'lazy'}
                  fetchpriority={i < eager ? 'high' : 'auto'}
                  decoding="async"
                />
                {(it.title || it.caption) && (
                  <>
                    <span class="asg-egallery__scrim" aria-hidden="true" />
                    <span class="asg-egallery__label" aria-hidden="true">
                      {it.title && <strong>{it.title}</strong>}
                      {it.caption && <span>{it.caption}</span>}
                    </span>
                  </>
                )}
              </a>
            </figure>
          </li>
        ))}
      </ul>
      {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    </>
  )
}

<script>
  import { initEditorialLightboxes } from '../internal/editorial-lightbox.js';

  function markLoaded() {
    document
      .querySelectorAll<HTMLImageElement>(
        '.asg-egallery .asg-jgallery__item img:not([data-asg-seen])',
      )
      .forEach((img) => {
        img.dataset.asgSeen = 'true';
        const done = () => img.closest('.asg-jgallery__figure')?.classList.add('is-loaded');
        if (img.complete) done();
        else img.addEventListener('load', done, { once: true });
      });
  }

  initEditorialLightboxes();
  markLoaded();
  document.addEventListener('astro:page-load', markLoaded);
  document.addEventListener('astro:after-swap', markLoaded);
</script>
