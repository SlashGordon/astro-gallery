#!/bin/sh
# Format staged files with Prettier so `pnpm run format:check` passes in CI.
# Note: re-stages whole files, so partially staged files get committed in full.

if [ -z "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
  exit 0
fi

# pnpm from npm's global folder, which the login shell puts on PATH only in interactive shells.
command -v pnpm >/dev/null 2>&1 || PATH="$HOME/.npm-global/bin:$PATH"

git diff --cached --name-only -z --diff-filter=ACMR |
  xargs -0 pnpm exec prettier --write --ignore-unknown --log-level warn || exit 1

git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 git add
