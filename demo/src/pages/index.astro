---
import ImageGallery from 'astro-gallery/components/ImageGallery.astro';
import EditorialGallery from 'astro-gallery/components/EditorialGallery.astro';
import JustifiedGallery from 'astro-gallery/components/JustifiedGallery.astro';
import SlideshowGallery from 'astro-gallery/components/SlideshowGallery.astro';
import CarouselGallery from 'astro-gallery/components/CarouselGallery.astro';
import ImageTimeline from 'astro-gallery/components/ImageTimeline.astro';
import MapGallery from 'astro-gallery/components/MapGallery.astro';

const photoTitles = {
  '1.jpg': 'The field above the beach',
  '2.jpg': 'The climb to the engine house',
  '3.jpg': 'Cliffs, heather, and one impatient dog',
  '4.jpg': 'Slate roofs, Thuringia',
  '5.jpg': 'South bank, shot from the north',
  '6.jpg': "Morton's Tower",
  '7.jpg': 'The track up to the farmhouse',
  '8.jpg': 'Baltic, out of season',
  '9.jpg': 'Beech wood in November',
  '10.jpg': 'Pine and heath in January',
  '11.jpg': 'Poppies at the field edge',
  '12.jpg': 'Bench, birches, lake',
  '13.jpg': 'The heath comes over all at once',
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>astro-gallery — demo</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #fafafa;
        --fg: #18181b;
        --muted: #71717a;
        --card: #fff;
        --line: rgba(0, 0, 0, 0.1);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0b0f;
          --fg: #e4e4e7;
          --muted: #a1a1aa;
          --card: #131318;
          --line: rgba(255, 255, 255, 0.08);
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font:
          16px/1.6 system-ui,
          -apple-system,
          Segoe UI,
          Roboto,
          sans-serif;
      }
      main {
        max-width: 920px;
        margin: 0 auto;
        padding: 3rem 1.25rem 6rem;
      }
      header p {
        color: var(--muted);
        max-width: 60ch;
      }
      h1 {
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        margin-bottom: 0.25rem;
      }
      h2 {
        margin-top: 3.5rem;
        border-top: 1px solid var(--line);
        padding-top: 2rem;
      }
      code {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 0.1rem 0.35rem;
        font-size: 0.9em;
      }
      .callout {
        margin-top: 2rem;
        padding: 0.9rem 1.1rem;
        border-left: 3px solid currentColor;
        background: var(--card);
        border-radius: 0 8px 8px 0;
        font-size: 0.95rem;
      }
      .theme-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        padding: 0.4rem 0.8rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--card);
        color: var(--fg);
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <button class="theme-toggle" type="button" data-theme-toggle>Toggle theme</button>
    <main>
      <header>
        <h1>astro-gallery</h1>
        <p>
          Seven folder-driven components, all reading from
          <code>src/assets/images/holidays/</code>. These are real holiday snapshots. Most carry
          EXIF (capture date + GPS), so the timeline and the map have something to work with. A few
          are messenger exports with the metadata stripped, so they land in the timeline's
          <code>Undated</code> group and never on the map. View source for the semantic markup and the
          JSON-LD.
        </p>
      </header>

      <p class="callout">
        The next two sections render the <strong>same thirteen photos</strong> — a mix of landscape and
        portrait, shot on different trips. Only the <em>layout</em> differs.
      </p>

      <h2>&lt;JustifiedGallery /&gt;</h2>
      <p>
        Rows are justified to the container width using each photo's aspect ratio, so a panorama
        takes more room than a portrait and nothing is cropped. Plus responsive <code>srcset</code>,
        blur-up skeletons, <code>content-visibility</code> and JSON-LD. Two of the photos below have a
        <code>caption</code> — hover or focus them to see it.
      </p>
      <JustifiedGallery
        folderPath="holidays"
        album="Holiday snapshots"
        rowHeight={220}
        alt={{
          '1.jpg': 'Evening light on the Cornwall coast',
          '7.jpg': 'A dirt track climbing to a farmhouse on a Tuscan ridge',
        }}
        captions={{
          '5.jpg': 'The London Eye and County Hall from the Embankment',
          '7.jpg': 'Tuscany, late August — the track up to the ridge',
        }}
      />

      <h2>&lt;ImageGallery /&gt;</h2>
      <p>
        The same photos in a uniform four-column grid. Every cell is identical, so each image is
        cropped to fill it — the panorama and the portraits all become the same rectangle. Here the
        <code>caption</code> renders as an always-visible <code>&lt;figcaption&gt;</code> under the image.
      </p>
      <ImageGallery
        folderPath="holidays"
        columns={4}
        album="Holiday snapshots"
        captions={{
          '4.jpg': 'A slate-roofed valley town in the Thuringian Forest',
          '6.jpg': 'Lambeth Palace gatehouse, early autumn',
        }}
      />

      <p>
        <code>variant="masonry"</code> keeps every photo's own aspect ratio instead of cropping to a uniform
        cell, and the caption moves to a hover scrim riding on the image:
      </p>
      <ImageGallery
        folderPath="holidays"
        columns={4}
        variant="masonry"
        album="Holiday snapshots"
        captions={{
          '1.jpg': 'The field above the beach',
          '3.jpg': 'Cliffs, heather, and one impatient dog',
          '5.jpg': 'The London Eye and County Hall from the Embankment',
          '7.jpg': 'Tuscany, late August — the track up to the ridge',
          '12.jpg': 'A swimming lake at the end of June',
        }}
      />

      <h2>&lt;EditorialGallery /&gt;</h2>
      <p>
        The same justified rows, but clicking a photo opens a two-pane reader: the picture on the
        left, a caption panel on the right carrying the title, the caption and the EXIF facts (date,
        camera, place, pixel size). The panel glass picks up colour from a blurred copy of the
        current photo. Use <kbd>←</kbd> / <kbd>→</kbd> to move, the filmstrip to jump, and the button
        in the panel header to collapse it for a clean full-bleed view.
      </p>
      <p>
        All thirteen photos carry a title and a paragraph of copy, so the panel always has something
        to hold. The EXIF block sits at the foot of the column, and the copy above it keeps its
        position whether the photo is a wide landscape or a tall portrait.
      </p>
      <EditorialGallery
        folderPath="holidays"
        album="Holiday snapshots"
        rowHeight={260}
        titles={{
          '1.jpg': 'The field above the beach',
          '2.jpg': 'The climb to the engine house',
          '3.jpg': 'Cliffs, heather, and one impatient dog',
          '4.jpg': 'Slate roofs, Thuringia',
          '5.jpg': 'South bank, shot from the north',
          '6.jpg': "Morton's Tower",
          '7.jpg': 'The track up to the farmhouse',
          '8.jpg': 'Baltic, out of season',
          '9.jpg': 'Beech wood in November',
          '10.jpg': 'Pine and heath in January',
          '11.jpg': 'Poppies at the field edge',
          '12.jpg': 'Bench, birches, lake',
          '13.jpg': 'The heath comes over all at once',
        }}
        captions={{
          '1.jpg':
            'Two weeks without rain had taken the grass down to straw. We came up here most evenings because it was the only flat ground for a mile in any direction, and because of the thing the light does in August, where it turns the whole field the colour of the sand below it.',
          '2.jpg':
            'The coast path bends inland here and then throws you straight up the hill. The chimney has been standing since long after the tin ran out, and on a still day you can hear the sea working away at the cliff underneath it.',
          '3.jpg':
            'Caves cut into the headland below, the heather just going over, and a labrador who had decided some time ago that we were walking too slowly. This is about a mile past the point where the path stops pretending to have a handrail.',
          '4.jpg':
            'A valley town in the Thuringian Forest seen from the tower. Everything here is roofed in the local slate — the walls too, in places — so on a bright morning the whole place reads as one long grey-blue line with the hills closing in behind it.',
          '5.jpg':
            'October, and London had decided to put on the good weather: high cirrus, and the kind of blue you get about three times a year. The wheel does not photograph well from underneath, so you cross the river and take it from the Embankment with County Hall alongside for scale.',
          '6.jpg':
            'The red-brick gatehouse of Lambeth Palace, next to St Mary-at-Lambeth — which stopped being a parish church some time ago and is now the garden museum. The plane tree has been quietly winning the argument with both of them for about two hundred years.',
          '7.jpg':
            'Late August in the Crete Senesi, when the grass has gone gold and the ploughing has not started. The track climbs for a good twenty minutes to that house on the ridge. There is no shade anywhere along it, and we did it at two in the afternoon, which was a mistake.',
          '8.jpg':
            'Flat water, wooden groynes marching away to the right, and a beach wide enough that the sea looks further off than it really is. September on the Ostsee — warm sand, cold water, and almost nobody about.',
          '9.jpg':
            'The stream is barely a stream by this point in the year, just a dark line pulling the leaves downhill. Beech does the best autumn of any tree here: it holds that copper colour for weeks after the oaks have given up entirely.',
          '10.jpg':
            'Winter light through birch and Scots pine. Nothing is flowering, nothing is green except the needles, and the whole wood smells of wet sand — which is more or less what the ground is, this far north.',
          '11.jpg':
            "They come up in the strip the plough misses, every year, and they are gone again inside a fortnight. Taken at arm's length down into the grass, because the wind would not hold still long enough to do it any other way.",
          '12.jpg':
            'A swimming lake at the end of June, with the birches just about holding their shape against the light. The bench faces the water, which is the entire reason it is there.',
          '13.jpg':
            'The heath flowers all at once and then the horizon is purple for about three weeks. One oak, a great deal of sky, and enough bees working the ground that you can hear it from the path.',
        }}
      />

      <h2>&lt;SlideshowGallery /&gt;</h2>
      <p>
        One photo at a time on a translate-driven track — nothing animates but a single
        <code>transform</code> and some opacity, on an expo-out curve that starts fast and settles slowly.
        Drag it with a mouse or a finger and the track follows you 1:1. Hover the image, or tab to the
        slideshow and use <kbd>←</kbd> / <kbd>→</kbd>, to raise the glass caption card.
      </p>
      <SlideshowGallery
        folderPath="holidays"
        album="Holiday snapshots"
        aspectRatio="16 / 9"
        titles={photoTitles}
        captions={{
          '1.jpg':
            'Two weeks without rain had taken the grass down to straw, and the light does this thing in August where it turns the whole field the colour of the sand below it.',
          '2.jpg':
            'The coast path bends inland here and then throws you straight up the hill. On a still day you can hear the sea working away at the cliff underneath the chimney.',
          '3.jpg':
            'Caves cut into the headland below, the heather just going over, and a labrador who had decided some time ago that we were walking too slowly.',
          '4.jpg':
            'Everything here is roofed in the local slate — the walls too, in places — so the whole valley reads as one long grey-blue line with the hills closing in behind it.',
          '5.jpg':
            'The wheel does not photograph well from underneath, so you cross the river and take it from the Embankment with County Hall alongside for scale.',
          '6.jpg':
            'The plane tree has been quietly winning its argument with the gatehouse and the church for about two hundred years.',
          '7.jpg':
            'The track climbs for a good twenty minutes to that house on the ridge. There is no shade anywhere along it, and we did it at two in the afternoon.',
          '8.jpg':
            'Flat water, wooden groynes marching away to the right, and a beach wide enough that the sea looks further off than it really is.',
          '9.jpg':
            'Beech does the best autumn of any tree here: it holds that copper colour for weeks after the oaks have given up entirely.',
          '10.jpg':
            'Nothing is flowering, nothing is green except the needles, and the whole wood smells of wet sand — which is more or less what the ground is.',
          '11.jpg':
            'They come up in the strip the plough misses, every year, and they are gone again inside a fortnight.',
          '12.jpg':
            'A swimming lake at the end of June, with the birches just about holding their shape against the light.',
          '13.jpg':
            'The heath flowers all at once and then the horizon is purple for about three weeks. Enough bees working the ground that you can hear it from the path.',
        }}
      />

      <p>
        <code>captionMode="always"</code> pins the card open, <code>autoplay</code> adds a timed advance
        with a pause control (and never starts under <code>prefers-reduced-motion</code>), and <code
          >radius</code
        > / <code>aspectRatio</code> reshape the stage:
      </p>
      <SlideshowGallery
        folderPath="holidays"
        album="Holiday snapshots"
        aspectRatio="21 / 9"
        radius="8px"
        fit="contain"
        captionMode="always"
        autoplay
        interval={5000}
        dots={false}
        titles={photoTitles}
      />

      <h2>&lt;CarouselGallery /&gt;</h2>
      <p>
        A fanned stack of prints: the centre photo sits full-size, its neighbours peek at the edges
        — scaled down, dimmed and tilted in perspective by their distance from the centre. Click a
        peeking print, drag, or use the arrows to bring it forward. The caption lives in its own
        strip below the stage and crossfades as the centre print changes, rather than riding on the
        photo the way <code>SlideshowGallery</code>'s does.
      </p>
      <CarouselGallery
        folderPath="holidays"
        album="Holiday snapshots"
        titles={photoTitles}
        captions={{
          '1.jpg':
            'Two weeks without rain had taken the grass down to straw, and the light does this thing in August where it turns the whole field the colour of the sand below it.',
          '2.jpg': 'The coast path bends inland here and then throws you straight up the hill.',
          '3.jpg':
            'Caves cut into the headland below, the heather just going over, and a labrador who had decided some time ago that we were walking too slowly.',
          '4.jpg': 'Everything here is roofed in the local slate — the walls too, in places.',
          '5.jpg':
            'The wheel does not photograph well from underneath, so you cross the river and take it from the Embankment.',
          '6.jpg': 'The plane tree has been quietly winning its argument for two hundred years.',
          '7.jpg': 'The track climbs for a good twenty minutes to that house on the ridge.',
          '8.jpg': 'Flat water, wooden groynes marching away to the right.',
          '9.jpg': 'Beech does the best autumn of any tree here.',
          '10.jpg': 'Nothing is flowering, nothing is green except the needles.',
          '11.jpg': 'They come up in the strip the plough misses, every year.',
          '12.jpg': 'A swimming lake at the end of June.',
          '13.jpg': 'The heath flowers all at once and the horizon goes purple for three weeks.',
        }}
      />

      <h2>&lt;ImageTimeline /&gt;</h2>
      <p>
        Grouped by EXIF capture day; photos without a date fall into an
        <code>Undated</code> group at the end. <code>orientation="horizontal"</code> (default) puts the
        days in a rail you scroll sideways:
      </p>
      <ImageTimeline folderPath="holidays" album="Holiday snapshots" />

      <p><code>orientation="vertical"</code> stacks them down the page on a left-hand spine:</p>
      <ImageTimeline folderPath="holidays" album="Holiday snapshots" orientation="vertical" />

      <h2>&lt;MapGallery /&gt;</h2>
      <p>
        Built from GPS EXIF. Nothing is requested from the tile provider until you accept the
        consent gate. A crawlable thumbnail list is rendered underneath for search engines and no-JS
        visitors (view source). Default <code>basemap="osm"</code>:
      </p>
      <MapGallery folderPath="holidays" album="Holiday snapshots" />

      <p>
        <code>basemap="esri-satellite"</code> — a different (keyless) style; the preset also forces the
        map controls dark. CARTO / Stadia dark presets work the same way but need a
        <code>tileApiKey</code>.
      </p>
      <MapGallery folderPath="holidays" album="Holiday snapshots" basemap="esri-satellite" />
    </main>

    <script>
      const btn = document.querySelector('[data-theme-toggle]');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.asgTheme === 'light' ? 'dark' : 'light';
        root.dataset.asgTheme = next;
        root.style.colorScheme = next;
      });
    </script>
  </body>
</html>
