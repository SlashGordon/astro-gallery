{
  "name": "astro-gallery",
  "version": "1.0.4",
  "description": "Folder-driven image galleries for Astro: a responsive grid with lightbox, an EXIF-date timeline, and a GDPR-friendly photo map — all powered by astro:assets.",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "withastro",
    "gallery",
    "lightbox",
    "images",
    "image-optimization",
    "exif",
    "leaflet",
    "map",
    "photos",
    "timeline",
    "gdpr"
  ],
  "homepage": "https://github.com/SlashGordon/astro-gallery#readme",
  "bugs": {
    "url": "https://github.com/SlashGordon/astro-gallery/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SlashGordon/astro-gallery.git"
  },
  "license": "MIT",
  "author": "SlashGordon",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.astro"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*",
    "./styles.css": "./src/styles/gallery.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:viewer": "node scripts/inspect-editorial-viewer.mjs",
    "screenshots": "npm --prefix demo run build && node scripts/capture-screenshots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:demo": "npm --prefix demo run dev",
    "demo": "npm --prefix demo run dev",
    "demo:build": "npm --prefix demo run build",
    "prepare": "npm run build"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.20",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "astro": "^7.2.9",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
